OPENAI_API_KEY=
DATABASE_URL=

# Set to false when Neo4j is not running locally.
GRAPH_ENABLED=true
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
# Required only when GRAPH_ENABLED=true; use a local password and never commit backend/.env.
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
GRAPH_ENTITY_EXTRACTION_ENABLED=true
GRAPH_ENTITY_EXTRACTION_MAX_CHUNKS=8

CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
